PORT=8787
MYSQL_HOST=YOUR_HEATWAVE_HOST
MYSQL_PORT=3306
MYSQL_USER=febraban_chat
MYSQL_PASSWORD=
MYSQL_DATABASE=fraud_demo_public
MYSQL_SSL=false
# Comece com true para ensaiar a interface sem banco. Use false no laboratório
# completo, após executar os scripts de bootstrap e configurar o HeatWave.
USE_MOCK_DATA=true
OPENAI_API_KEY=
OPENAI_MODEL=
USE_OPENAI_AGENT=false
# Linguagem natural nativa do MySQL HeatWave GenAI.
# Requer EXECUTE somente em sys.NL_SQL e sys.ML_GENERATE para o usuário acima.
USE_HEATWAVE_NL_SQL=true
# Modelo maior hospedado no OCI Generative AI e servido por GPU. Validado no DB System em 12/08/2026.
HEATWAVE_NL_SQL_MODEL=meta.llama-3.3-70b-instruct
# Pode ser trocado separadamente se a síntese precisar de outro modelo.
HEATWAVE_NL_SQL_SUMMARY_MODEL=meta.llama-3.3-70b-instruct
# RAG documental: embedding e geração no OCI Generative AI (GPU).
USE_HEATWAVE_RAG=true
HEATWAVE_RAG_VECTOR_STORE=febraban_rag.modelo_b1_v2_oci_embed_v4_rev3_20260823
HEATWAVE_RAG_EMBED_MODEL=cohere.embed-v4.0
# Limite do backend para uma chamada documental; fallback seguro preserva a demo.
HEATWAVE_RAG_TIMEOUT_MS=30000
